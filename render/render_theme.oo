// # Theme and Terminal Renderer - Color Palettes and Entity Styling
//
// Logline: Hydrates terminal palette from ~/.openooda/theme.oot for process tree visualization.
//
// Setup: Requires FsReadCap and EnvCap. Operates with zero ambient authority.
//
// Beats:
//   1. Resolve theme name from override, OODA_THEME, or ~/.openooda/theme.oot with fallback.
//   2. Color-code process entities (PIDs, states, slice badges, and command names).
//   3. Render process rows with tree branches and ANSI color accents or plain text.

import "std/fs/process/env.oo";
import "proc/proc_info.oo";
import "proc/proc_tree.oo";

pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

pub fn term_reset() -> String {
    return ansi_esc() + "[0m";
}

pub fn parse_theme_val(line: String, key: String) -> String {
    let trimmed: String = str_trim(line);
    if !str_starts_with(trimmed, key) { return ""; }
    let rest: String = str_trim(str_slice(trimmed, chars_len(key), chars_len(trimmed)));
    if !str_starts_with(rest, "=") { return ""; }
    let mut val: String = str_trim(str_slice(rest, 1, chars_len(rest)));
    if str_starts_with(val, "\"") && str_ends_with(val, "\"") {
        let n: Int = chars_len(val);
        if n >= 2 { val = str_slice(val, 1, n - 1); }
    }
    return val;
}

pub fn parse_theme_key(content: String, key: String) -> String {
    let n: Int = chars_len(content);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(content, i);
        if c == "\n" {
            let v: String = parse_theme_val(cur, key);
            if v != "" { return v; }
            cur = "";
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    if cur != "" {
        let v: String = parse_theme_val(cur, key);
        if v != "" { return v; }
    }
    return "";
}

pub fn resolve_ps_theme(fs: &FsReadCap, env: &EnvCap, theme_override: String) -> String {
    if chars_len(theme_override) > 0 { return theme_override; }
    let env_t: Result[String, String] = env_get(env, "OODA_THEME");
    if env_t.is_ok() {
        let t: String = match env_t { Ok(s) => s, Err(_) => "" };
        if t != "" { return t; }
    }
    let env_home: Result[String, String] = env_get(env, "OODA_HOME");
    let mut home: String = match env_home { Ok(s) => s, Err(_) => "" };
    if home == "" {
        let env_w: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
        home = match env_w { Ok(s) => s, Err(_) => "" };
    }
    if home == "" {
        let env_h: Result[String, String] = env_get(env, "HOME");
        home = match env_h { Ok(s) => s, Err(_) => "" };
    }
    let p: String = if str_ends_with(home, "/") { home + ".openooda/theme.oot" } else { home + "/.openooda/theme.oot" };
    let r: Result[String, String] = read_file(fs, p);
    if r.is_err() { return "classic/1982"; }
    let content: String = match r { Ok(s) => s, Err(_) => "" };
    let t: String = parse_theme_key(content, "theme");
    return if t != "" { t } else { "classic/1982" };
}

pub fn style_state(state: String, no_color: Bool) -> String {
    if no_color { return state; }
    let esc: String = ansi_esc();
    let reset: String = term_reset();
    if state == "R" { return esc + "[1;32m" + state + reset; }
    if state == "S" { return esc + "[34m" + state + reset; }
    if state == "Z" { return esc + "[1;31m" + state + reset; }
    if state == "T" { return esc + "[1;33m" + state + reset; }
    return esc + "[90m" + state + reset;
}

pub fn style_slice(slice: String, no_color: Bool) -> String {
    let badge: String = get_slice_badge(slice);
    if no_color { return badge; }
    let esc: String = ansi_esc();
    let reset: String = term_reset();
    if slice == "system.slice" { return esc + "[1;36m" + badge + reset; }
    if slice == "user.slice" { return esc + "[1;35m" + badge + reset; }
    if slice == "kernel" { return esc + "[90m" + badge + reset; }
    return esc + "[33m" + badge + reset;
}

pub fn theme_pid_color(theme: String) -> String {
    if str_contains(theme, "dracula") || str_contains(theme, "amethyst") { return "35"; }
    if str_contains(theme, "cyberpunk") || str_contains(theme, "matrix") { return "32"; }
    if str_contains(theme, "amber") { return "33"; }
    if str_contains(theme, "nord") || str_contains(theme, "ocean") { return "36"; }
    return "33";
}

pub fn render_process_row(p: ProcessInfo, prefix: String, no_color: Bool, theme: String) -> String {
    let pid_str: String = to_string(p.pid);
    let mut padded_pid: String = pid_str;
    while chars_len(padded_pid) < 7 {
        padded_pid = " " + padded_pid;
    }
    let st_col: String = style_state(p.state, no_color);
    let sl_col: String = style_slice(p.slice, no_color);
    if no_color {
        return padded_pid + " " + st_col + " " + sl_col + " " + prefix + p.comm;
    }
    let esc: String = ansi_esc();
    let reset: String = term_reset();
    let pid_code: String = theme_pid_color(theme);
    let pid_col: String = esc + "[" + pid_code + "m" + padded_pid + reset;
    let comm_col: String = esc + "[1;37m" + p.comm + reset;
    let branch_col: String = esc + "[90m" + prefix + reset;
    return pid_col + " " + st_col + " " + sl_col + " " + branch_col + comm_col;
}

pub fn render_hierarchy_branch(
    procs: List[ProcessInfo],
    parent_pid: Int,
    indent: String,
    ascii_mode: Bool,
    no_color: Bool,
    theme: String,
    depth: Int
) -> String {
    if depth > 64 { return ""; }
    let children: List[ProcessInfo] = get_children(procs, parent_pid);
    let nc: Int = list_len(children);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < nc {
        let ch: ProcessInfo = list_get(children, i);
        let is_last: Bool = (i == nc - 1);
        let branch: String = if ascii_mode {
            if is_last { "\\-- " } else { "|-- " }
        } else {
            if is_last { "└── " } else { "├── " }
        };
        out = out + render_process_row(ch, indent + branch, no_color, theme) + "\n";
        let next_indent: String = indent + (if ascii_mode {
            if is_last { "    " } else { "|   " }
        } else {
            if is_last { "    " } else { "│   " }
        });
        out = out + render_hierarchy_branch(procs, ch.pid, next_indent, ascii_mode, no_color, theme, depth + 1);
        i = i + 1;
    }
    return out;
}
