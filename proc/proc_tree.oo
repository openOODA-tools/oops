// # Process Tree Hierarchy Builder
//
// Logline: Organizes flat process lists into parent-child hierarchies and slice clusters.
//
// Setup: Pure algorithm on in-memory ProcessInfo collections.
//
// Beats:
//   1. Identify root tasks (systemd, kernel kthreadd, or orphaned parents).
//   2. Query direct children for any specified parent PID.
//   3. Partition tasks into systemd slice groups (system.slice, user.slice, kernel, other).
//   4. Format process row entries with tree branch glyphs and slice badges.

import "proc_info.oo";

pub fn get_children(procs: List[ProcessInfo], parent_pid: Int) -> List[ProcessInfo] {
    let mut out: List[ProcessInfo] = list_new();
    let n: Int = list_len(procs);
    let mut i: Int = 0;
    while i < n {
        let p: ProcessInfo = list_get(procs, i);
        if p.ppid == parent_pid && p.pid != parent_pid {
            out = list_push(out, p);
        }
        i = i + 1;
    }
    return out;
}

pub fn has_pid(procs: List[ProcessInfo], target_pid: Int) -> Bool {
    let n: Int = list_len(procs);
    let mut i: Int = 0;
    while i < n {
        let p: ProcessInfo = list_get(procs, i);
        if p.pid == target_pid {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn get_roots(procs: List[ProcessInfo]) -> List[ProcessInfo] {
    let mut out: List[ProcessInfo] = list_new();
    let n: Int = list_len(procs);
    let mut i: Int = 0;
    while i < n {
        let p: ProcessInfo = list_get(procs, i);
        if p.ppid == 0 || p.pid == 1 || (p.pid == 2 && p.ppid == 0) || !has_pid(procs, p.ppid) {
            out = list_push(out, p);
        }
        i = i + 1;
    }
    return out;
}

pub fn get_slice_badge(slice_name: String) -> String {
    if slice_name == "system.slice" { return "[system]"; }
    if slice_name == "user.slice" { return "[user]"; }
    if slice_name == "init.scope" { return "[init]"; }
    if slice_name == "kernel" { return "[kernel]"; }
    return "[other]";
}

pub fn format_proc_line(p: ProcessInfo, prefix: String) -> String {
    let pid_str: String = to_string(p.pid);
    let mut padded_pid: String = pid_str;
    while chars_len(padded_pid) < 7 {
        padded_pid = " " + padded_pid;
    }
    let badge: String = get_slice_badge(p.slice);
    return padded_pid + " " + p.state + " " + badge + " " + prefix + p.comm;
}

pub fn render_tree_table(procs: List[ProcessInfo]) -> String {
    let mut out: String = "    PID S SLICE    COMMAND\n";
    let n: Int = list_len(procs);
    let mut i: Int = 0;
    while i < n {
        let p: ProcessInfo = list_get(procs, i);
        out = out + format_proc_line(p, "") + "\n";
        i = i + 1;
    }
    return out;
}

pub fn render_tree_hierarchy(procs: List[ProcessInfo], ascii_mode: Bool) -> String {
    let mut out: String = "    PID S SLICE    COMMAND\n";
    let roots: List[ProcessInfo] = get_roots(procs);
    let n_roots: Int = list_len(roots);
    let mut r: Int = 0;
    while r < n_roots {
        let root: ProcessInfo = list_get(roots, r);
        out = out + format_proc_line(root, "") + "\n";

        let children: List[ProcessInfo] = get_children(procs, root.pid);
        let nc: Int = list_len(children);
        let mut c: Int = 0;
        while c < nc {
            let ch: ProcessInfo = list_get(children, c);
            let is_last_c: Bool = (c == nc - 1);
            let branch: String = if ascii_mode {
                if is_last_c { "\\-- " } else { "|-- " }
            } else {
                if is_last_c { "└── " } else { "├── " }
            };
            let sub_indent: String = if ascii_mode {
                if is_last_c { "    " } else { "|   " }
            } else {
                if is_last_c { "    " } else { "│   " }
            };
            out = out + format_proc_line(ch, branch) + "\n";

            let grand_children: List[ProcessInfo] = get_children(procs, ch.pid);
            let ng: Int = list_len(grand_children);
            let mut g: Int = 0;
            while g < ng {
                let gch: ProcessInfo = list_get(grand_children, g);
                let is_last_g: Bool = (g == ng - 1);
                let gbranch: String = if ascii_mode {
                    if is_last_g { sub_indent + "\\-- " } else { sub_indent + "|-- " }
                } else {
                    if is_last_g { sub_indent + "└── " } else { sub_indent + "├── " }
                };
                let sub2_indent: String = sub_indent + (if ascii_mode {
                    if is_last_g { "    " } else { "|   " }
                } else {
                    if is_last_g { "    " } else { "│   " }
                });
                out = out + format_proc_line(gch, gbranch) + "\n";

                let gg_children: List[ProcessInfo] = get_children(procs, gch.pid);
                let ngg: Int = list_len(gg_children);
                let mut gg: Int = 0;
                while gg < ngg {
                    let ggch: ProcessInfo = list_get(gg_children, gg);
                    let is_last_gg: Bool = (gg == ngg - 1);
                    let ggbranch: String = if ascii_mode {
                        if is_last_gg { sub2_indent + "\\-- " } else { sub2_indent + "|-- " }
                    } else {
                        if is_last_gg { sub2_indent + "└── " } else { sub2_indent + "├── " }
                    };
                    out = out + format_proc_line(ggch, ggbranch) + "\n";
                    gg = gg + 1;
                }
                g = g + 1;
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return out;
}
